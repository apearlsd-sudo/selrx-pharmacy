generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ROLES & PERMISSIONS ============

model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. SUPER_ADMIN, PHARMACIST, CASHIER, custom roles
  label       String              // Display name: "Super Admin", "Pharmacist"
  description String?
  permissions String              // JSON-encoded array of granular permission keys
  color       String   @default("bg-gray-100 text-gray-700 border-gray-200")  // Tailwind badge classes
  isSystem    Boolean  @default(false)  // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("CLERK")
  phone         String?
  licenseNumber String?  // For pharmacists
  permissions   String?  // JSON-encoded array of permission keys (overrides role defaults)
  department    String?  // Department assignment (e.g. Pharmacy, Front Desk, Finance)
  shift         String?  // Shift assignment (e.g. Morning, Afternoon, Night)
  hireDate      String?  // ISO date string for hire date
  pinCode       String?  // bcrypt-hashed user PIN for goods-return approval
  active        Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions       Transaction[]
  returnsProcessed   Return[]
  returnsApproved    Return[]          @relation("ReturnApprover")
  prescriptionsFilled Prescription[] @relation("Dispenser")
  prescriptionsVerified Prescription[] @relation("Verifier")
  logs               AuditLog[]
  productHistory     ProductHistory[]
  ownedCompany      Company?  @relation("CompanyOwner")
  stockTakes        StockTake[]  @relation("StockTakeCounter")
  purchaseOrders     PurchaseOrder[] @relation("POCreator")
  systemRole        SystemRole? @relation(fields: [role], references: [name])
}

// ============ CUSTOMERS / PATIENTS ============

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth String?
  gender      String?
  address     String?
  insuranceProvider String?
  insurancePolicyNo  String?
  allergies   String?  // Comma-separated
  notes       String?
  loyaltyPoints  Int      @default(0)
  loyaltyTier    String   @default("BRONZE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescriptions     Prescription[]
  transactions      Transaction[]
  credits           CustomerCredit[]
  loyaltyTransactions LoyaltyTransaction[]
  insuranceClaims   InsuranceClaim[]
}

// ============ DOSAGE FORMS ============

model DosageForm {
  id        String   @id @default(cuid())
  name      String   @unique  // e.g. TABLET, CAPSULE, SYRUP, CREAM
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PRODUCTS / MEDICATIONS ============

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  RECALLED
}

model Product {
  id                String          @id @default(cuid())
  ndc               String?         @unique // National Drug Code
  barcode           String?         @unique // EAN-13 barcode (auto-generated from NDC or random)
  name              String
  genericName       String?
  manufacturer      String?
  manufacturerId    String?
  vendorId          String?
  category          String          @default("OTC")
  description       String?
  dosageForm        String?         // Tablet, Capsule, Liquid, Cream, etc.
  strength          String?         // 500mg, 10ml, etc.
  unitOfMeasure     String          @default("EA") // EA, BOX, PACK
  sellingUnit        String          @default("EA") // Tablet, Capsule, Strip, Blister, Sachet, Vial, Ampoule, Bottle, EA
  itemsPerUnit       Int             @default(1) // e.g. 10 tablets per strip
  requiresPrescription Boolean      @default(false)
  status            ProductStatus   @default(ACTIVE)
  sellingPrice      Float
  wholesalePrice    Float?
  costPrice         Float?
  pricingTierId     String?
  reorderPoint      Int             @default(10)
  reorderQty        Int             @default(50)
  maxStock          Int?
  storageLocation   String?         // Aisle, Shelf, Bin
  batchNumber       String?
  expiryDate        String?
  controlledSubstance Boolean       @default(false)
  deaSchedule       String?         // For controlled substances
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  manufacturerRef   Manufacturer?   @relation("ProductManufacturer", fields: [manufacturerId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  inventory         Inventory[]
  transactionItems  TransactionItem[]
  categories        Category[]
  returns           Return[]
  stockTakeItems    StockTakeItem[]
  history           ProductHistory[]

  @@index([pricingTierId])
}

// ============ INVENTORY ============

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int      @default(0)
  lastCounted DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId])
}

// ============ TRANSACTIONS / SALES ============

enum TransactionStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_MONEY
  CREDIT
  INSURANCE
  FSA_HSA
  SPLIT
}

model Transaction {
  id              String            @id @default(cuid())
  transactionNo   String            @unique
  customerId      String?
  userId          String
  workstationId   String?
  subtotal        Float
  tax             Float             @default(0)
  discount        Float             @default(0)
  total           Float
  paymentMethod   PaymentMethod
  paymentAmount   Float
  changeAmount    Float             @default(0)
  status          TransactionStatus @default(PENDING)
  prescriptionId  String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  prescription    Prescription?     @relation(fields: [prescriptionId], references: [id])
  items           TransactionItem[]
  returns         Return[]
  workstation       Workstation?      @relation(fields: [workstationId], references: [id])
  hardwareLog       HardwareLog?
  insuranceClaim    InsuranceClaim?
  customerCredits   CustomerCredit[]
  loyaltyTransactions LoyaltyTransaction[]
  cardPayment         CardPayment?
  mobileMoneyPayment  MobileMoneyPayment?
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  unitPrice     Float
  subtotal      Float
  requiresRx    Boolean     @default(false)
  dispensedQty  Int?
  createdAt     DateTime    @default(now())

  transaction       Transaction @relation(fields: [transactionId], references: [id])
  product           Product     @relation(fields: [productId], references: [id])
  returns           Return[]
}

// ============ PRESCRIPTIONS ============

enum RxStatus {
  PENDING
  IN_PROGRESS
  READY
  DISPENSED
  EXPIRED
  CANCELLED
}

enum RxPriority {
  ROUTINE
  URGENT
  STAT
}

model Prescription {
  id                String      @id @default(cuid())
  rxNumber          String      @unique
  customerId        String
  patientName       String
  prescriberName    String
  prescriberNPI     String?
  prescriberPhone   String?
  prescriberFax     String?
  productName       String
  productNdc        String?
  dosage            String?
  quantity          Int
  refillsRemaining  Int
  refillsTotal      Int
  daysSupply        Int?
  dispenseAsWritten Boolean     @default(false)
  priority          RxPriority   @default(ROUTINE)
  status            RxStatus     @default(PENDING)
  notes             String?
  filledById        String?
  verifiedById      String?
  filledAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer   @relation(fields: [customerId], references: [id])
  filledBy          User?      @relation("Dispenser", fields: [filledById], references: [id])
  verifiedBy        User?      @relation("Verifier", fields: [verifiedById], references: [id])
  transactions      Transaction[]
  insuranceClaims   InsuranceClaim[]
}

// ============ HARDWARE LOG ============

enum HardwareAction {
  RECEIPT_PRINTED
  LABEL_PRINTED
  BARCODE_SCANNED
  CASH_DRAWER_OPENED
  SCALE_READ
}

model HardwareLog {
  id            String         @id @default(cuid())
  transactionId String?        @unique
  hardwareType  String         // receipt_printer, barcode_scanner, cash_drawer, label_printer, scale
  action        HardwareAction
  status        String         @default("success") // success, failed, pending
  details       String?        // JSON string with device details
  createdAt     DateTime       @default(now())

  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
}

// ============ GOODS RETURNS ============

enum ReturnStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  EXPIRED
  WRONG_ITEM
  WRONG_QUANTITY
  DAMAGED
  CUSTOMER_CHANGE_OF_MIND
  RECALLED
  OTHER
}

model Return {
  id              String        @id @default(cuid())
  returnNo        String        @unique // RTN-YYYYMMDD-XXXX
  transactionId   String
  transactionItemId String
  productId       String
  productName     String
  quantity        Int
  unitPrice       Float
  refundAmount    Float
  reason          ReturnReason
  reasonNote      String?
  customerId      String?
  customerName    String?
  userId          String         // who processed the return
  status          ReturnStatus  @default(PENDING_APPROVAL)
  approvedById    String?
  approvedAt      DateTime?
  refundMethod     PaymentMethod @default(CASH)
  refundProcessed Boolean       @default(false)
  restocked       Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transaction      Transaction      @relation(fields: [transactionId], references: [id])
  transactionItem  TransactionItem  @relation(fields: [transactionItemId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  approvedBy       User?            @relation("ReturnApprover", fields: [approvedById], references: [id])
}

// ============ WORKSTATIONS ============

model Workstation {
  id          String   @id @default(cuid())
  name        String   // e.g. "Counter 1", "Pharmacy Window"
  description String?
  location    String?  // e.g. "Front Desk", "Drive-Thru"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
}

// ============ COMPANY / STORE ============

model Company {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique // URL-friendly name
  logo              String?  // Logo URL or base64
  tagline           String?
  businessType      String   @default("Pharmacy") // Pharmacy, Clinic, Hospital, Retail
  registrationNo    String?  // Business registration number
  pharmacyLicense   String?  // Pharmacy license number
  taxId             String?
  phone             String?
  email             String?
  website           String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  currency          String   @default("USD")
  timezone          String   @default("UTC")
  active            Boolean  @default(true)
  ownerName         String?
  ownerId           String?  @unique // User ID of the company owner
  settings          String?  // JSON: { taxRate, defaultPaymentMethod, ... }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner             User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
}

// ============ MANUFACTURERS ============

model Manufacturer {
  id          String   @id @default(cuid())
  name        String   @unique
  contactPerson String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[] @relation("ProductManufacturer")
}

// ============ VENDORS ============

model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products        Product[]
  purchaseOrders  PurchaseOrder[]
  priceLists      SupplierPriceList[]
}

// ============ CATEGORIES ============

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ============ AUDIT LOG ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  category  String   @default("general")
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model ProductHistory {
  id            String   @id @default(cuid())
  productId     String
  action        String   // CREATED, UPDATED, DELETED
  changedFields String?  // comma-separated list of changed field names
  previousValues String? // JSON string of previous field values
  newValues     String?  // JSON string of new field values
  userId        String?
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
}

// ============ STOCK TAKE ============

enum StockTakeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockTake {
  id          String          @id @default(cuid())
  reference   String          @unique
  status      StockTakeStatus @default(PENDING)
  notes       String?
  countedBy   String?         // userId
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  countedByUser User?          @relation("StockTakeCounter", fields: [countedBy], references: [id])
  items         StockTakeItem[]
}

model StockTakeItem {
  id            String   @id @default(cuid())
  stockTakeId   String
  productId     String
  systemQty     Int      // current quantity in inventory
  countedQty    Int?     // physical count
  variance      Int?     // countedQty - systemQty
  notes         String?
  createdAt     DateTime @default(now())

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([stockTakeId, productId])
}

// ============ PURCHASE ORDERS ============

enum POStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  vendorId      String?
  vendorName    String
  status        POStatus  @default(DRAFT)
  notes         String?
  expectedDate  DateTime?
  totalAmount   Float     @default(0)
  receivedAmount Float    @default(0)
  createdBy      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor        Vendor?              @relation(fields: [vendorId], references: [id])
  creator       User                 @relation("POCreator", fields: [createdBy], references: [id])
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  receivedQty Int      @default(0)
  unitCost    Float
  createdAt   DateTime @default(now())

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============ PRICING TIERS ============

model PricingTier {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. Retail, Wholesale, NHIS, VIP
  description String?
  discountPercent Float   @default(0)  // e.g. 10 for 10% off
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ CUSTOMER CREDIT ============

model CustomerCredit {
  id            String   @id @default(cuid())
  customerId    String
  transactionId String?   // linked sale
  amount        Float    // positive = credit given, negative = payment made
  balance       Float    // running balance after this entry
  description   String?  // e.g. "Credit sale #TXN-001", "Payment received"
  createdBy      String?
  createdAt     DateTime @default(now())

  customer      Customer  @relation(fields: [customerId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

// ============ INSURANCE CLAIMS ============

enum ClaimStatus {
  PENDING
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

model InsuranceClaim {
  id              String      @id @default(cuid())
  claimNo         String      @unique  // CLM-YYYYMMDD-XXXX
  prescriptionId  String?
  transactionId   String   @unique
  customerId      String
  insuranceProvider String
  policyNumber    String
  totalAmount     Float
  approvedAmount  Float      @default(0)
  coPayAmount     Float      @default(0)
  status          ClaimStatus @default(PENDING)
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        Customer     @relation(fields: [customerId], references: [id])
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  transaction     Transaction  @relation(fields: [transactionId], references: [id])
}

// ============ SUPPLIER PRICE LISTS ============

model SupplierPriceList {
  id          String   @id @default(cuid())
  vendorId    String?
  vendorName  String
  validFrom   String?  // ISO date
  validTo     String?  // ISO date
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  items       SupplierPriceListItem[]
}

model SupplierPriceListItem {
  id              String   @id @default(cuid())
  priceListId     String
  productId       String?
  productName     String
  unitCost        Float
  packSize        Int?     // e.g. 100 tablets per pack
  minOrderQty     Int?
  createdAt       DateTime @default(now())

  priceList       SupplierPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
}

// ============ NOTIFICATIONS ============

enum NotificationType {
  EXPIRY_ALERT
  REORDER_ALERT
  REFILL_REMINDER
  CREDIT_DUE
  LOW_STOCK
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

model Notification {
  id          String             @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  entityType  String?            // e.g. Product, Customer, Prescription
  entityId    String?
  status      NotificationStatus @default(UNREAD)
  userId      String?            // null = broadcast to all
  createdAt   DateTime           @default(now())
  readAt     DateTime?
}

// ============ CARD PAYMENTS ============

enum CardPaymentStatus {
  COMPLETED
  DECLINED
  FAILED
  REFUNDED
}

enum CardEntryMethod {
  MANUAL
  CHIP
  CONTACTLESS
  TAP
}

// ============ MOBILE MONEY PAYMENTS ============

enum MobileMoneyStatus {
  PENDING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
}

model MobileMoneyPayment {
  id              String              @id @default(cuid())
  transactionId   String              @unique
  provider        String              // MTN_MOMO, TELECEL_CASH, AIRTEL_MONEY
  providerLabel   String              // Display label: "MTN Mobile Money", "Telecel Cash", "AirtelTigo Money"
  phoneNumber     String              // Masked: 0XXX *** XXXX
  reference       String?             // Unique reference: MOMO-YYYYMMDD-XXXXXX
  status          MobileMoneyStatus   @default(PENDING)
  responseCode    String?             // Processor response code
  approvalMessage String?             // Human-readable message
  createdAt       DateTime            @default(now())

  transaction     Transaction         @relation(fields: [transactionId], references: [id])
}

// ============ CARD PAYMENTS ============

model CardPayment {
  id              String            @id @default(cuid())
  transactionId   String            @unique
  cardLast4       String            // Only last 4 digits — PCI-DSS compliant
  cardBrand       String            // VISA, MASTERCARD, AMEX, DISCOVER, etc.
  authCode        String?           // 6-char authorization code
  refNumber       String?           // Unique reference: CARD-YYYYMMDD-XXXXXX
  status          CardPaymentStatus @default(COMPLETED)
  entryMethod     CardEntryMethod   @default(MANUAL)
  responseCode    String?           // Processor response code (00 = approved)
  approvalMessage String?           // Human-readable approval message
  createdAt       DateTime          @default(now())

  transaction     Transaction       @relation(fields: [transactionId], references: [id])
}

// ============ LOYALTY TRANSACTIONS ============

enum LoyaltyAction {
  EARNED
  REDEEMED
  ADJUSTED
  BONUS
}

model LoyaltyTransaction {
  id            String        @id @default(cuid())
  customerId    String
  transactionId String?
  points        Int           // positive = earned, negative = redeemed
  action        LoyaltyAction
  description   String?
  createdBy      String?
  createdAt     DateTime      @default(now())

  customer      Customer      @relation(fields: [customerId], references: [id])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
}

// ============ USER PERFORMANCE TARGETS ============

model UserTarget {
  id            String   @id @default(cuid())
  userId        String
  period        String   // e.g. 2026-08 (monthly), 2026-W33 (weekly)
  targetType    String   // SALES_AMOUNT, TRANSACTIONS_COUNT, ITEMS_SOLD
  targetValue   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ APPROVAL LOG (for PIN/supervisor approvals) ============

enum ApprovalAction {
  PRICE_OVERRIDE
  REFUND_APPROVAL
  CONTROLLED_DISPENSE
  DISCOUNT_OVERRIDE
  CREDIT_SALE
  VOID_TRANSACTION
}

model ApprovalLog {
  id            String         @id @default(cuid())
  action        ApprovalAction
  entityType    String?        // e.g. Transaction, Return, Prescription
  entityId      String?
  requesterId   String         // who requested approval
  approverId    String         // who approved (supervisor/PIN)
  details       String?        // JSON with context (original price, new price, etc.)
  approved      Boolean        @default(true)
  createdAt     DateTime       @default(now())
}
