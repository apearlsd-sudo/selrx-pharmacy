generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ROLES & PERMISSIONS ============

enum Role {
  SUPER_ADMIN
  PHARMACIST
  TECHNICIAN
  CASHIER
  CLERK
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(CLERK)
  phone         String?
  licenseNumber String?  // For pharmacists
  active        Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions       Transaction[]
  prescriptionsFilled Prescription[] @relation("Dispenser")
  prescriptionsVerified Prescription[] @relation("Verifier")
  logs               AuditLog[]
}

// ============ CUSTOMERS / PATIENTS ============

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth String?
  gender      String?
  address     String?
  insuranceProvider String?
  insurancePolicyNo  String?
  allergies   String?  // Comma-separated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescriptions Prescription[]
  transactions Transaction[]
}

// ============ PRODUCTS / MEDICATIONS ============

enum ProductCategory {
  OTC           // Over the counter
  PRESCRIPTION  // Prescription required
  SUPPLEMENT    // Supplements & vitamins
  MEDICAL_DEVICE // Medical devices
  PERSONAL_CARE // Personal care
  CONSUMABLES   // Consumables (bags, syringes, etc.)
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  RECALLED
}

model Product {
  id                String          @id @default(cuid())
  ndc               String?         @unique // National Drug Code
  name              String
  genericName       String?
  manufacturer      String?
  category          ProductCategory @default(OTC)
  description       String?
  dosageForm        String?         // Tablet, Capsule, Liquid, Cream, etc.
  strength          String?         // 500mg, 10ml, etc.
  unitOfMeasure     String          @default("EA") // EA, BOX, PACK
  requiresPrescription Boolean      @default(false)
  status            ProductStatus   @default(ACTIVE)
  sellingPrice      Float
  costPrice         Float?
  reorderPoint      Int             @default(10)
  reorderQty        Int             @default(50)
  maxStock          Int?
  storageLocation   String?         // Aisle, Shelf, Bin
  batchNumber       String?
  expiryDate        String?
  controlledSubstance Boolean       @default(false)
  deaSchedule       String?         // For controlled substances
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inventory         Inventory[]
  transactionItems  TransactionItem[]
}

// ============ INVENTORY ============

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int      @default(0)
  lastCounted DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId])
}

// ============ TRANSACTIONS / SALES ============

enum TransactionStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  INSURANCE
  FSA_HSA
  SPLIT
}

model Transaction {
  id              String            @id @default(cuid())
  transactionNo   String            @unique
  customerId      String?
  userId          String
  subtotal        Float
  tax             Float             @default(0)
  discount        Float             @default(0)
  total           Float
  paymentMethod   PaymentMethod
  paymentAmount   Float
  changeAmount    Float             @default(0)
  status          TransactionStatus @default(PENDING)
  prescriptionId  String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  prescription    Prescription?     @relation(fields: [prescriptionId], references: [id])
  items           TransactionItem[]

  hardwareLog     HardwareLog?
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  unitPrice     Float
  subtotal      Float
  requiresRx    Boolean     @default(false)
  dispensedQty  Int?
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

// ============ PRESCRIPTIONS ============

enum RxStatus {
  PENDING
  IN_PROGRESS
  READY
  DISPENSED
  EXPIRED
  CANCELLED
}

enum RxPriority {
  ROUTINE
  URGENT
  STAT
}

model Prescription {
  id                String      @id @default(cuid())
  rxNumber          String      @unique
  customerId        String
  patientName       String
  prescriberName    String
  prescriberNPI     String?
  prescriberPhone   String?
  prescriberFax     String?
  productName       String
  productNdc        String?
  dosage            String?
  quantity          Int
  refillsRemaining  Int
  refillsTotal      Int
  daysSupply        Int?
  dispenseAsWritten Boolean     @default(false)
  priority          RxPriority   @default(ROUTINE)
  status            RxStatus     @default(PENDING)
  notes             String?
  filledById        String?
  verifiedById      String?
  filledAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer   @relation(fields: [customerId], references: [id])
  filledBy          User?      @relation("Dispenser", fields: [filledById], references: [id])
  verifiedBy        User?      @relation("Verifier", fields: [verifiedById], references: [id])
  transactions      Transaction[]
}

// ============ HARDWARE LOG ============

enum HardwareAction {
  RECEIPT_PRINTED
  LABEL_PRINTED
  BARCODE_SCANNED
  CASH_DRAWER_OPENED
  SCALE_READ
}

model HardwareLog {
  id            String         @id @default(cuid())
  transactionId String?        @unique
  hardwareType  String         // receipt_printer, barcode_scanner, cash_drawer, label_printer, scale
  action        HardwareAction
  status        String         @default("success") // success, failed, pending
  details       String?        // JSON string with device details
  createdAt     DateTime       @default(now())

  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
}

// ============ AUDIT LOG ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
