generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ROLES & PERMISSIONS ============

model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. SUPER_ADMIN, PHARMACIST, CASHIER, custom roles
  label       String              // Display name: "Super Admin", "Pharmacist"
  description String?
  permissions String              // JSON-encoded array of granular permission keys
  color       String   @default("bg-gray-100 text-gray-700 border-gray-200")  // Tailwind badge classes
  isSystem    Boolean  @default(false)  // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("CLERK")
  phone         String?
  licenseNumber String?  // For pharmacists
  permissions   String?  // JSON-encoded array of permission keys (overrides role defaults)
  department    String?  // Department assignment (e.g. Pharmacy, Front Desk, Finance)
  shift         String?  // Shift assignment (e.g. Morning, Afternoon, Night)
  hireDate      String?  // ISO date string for hire date
  active        Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions       Transaction[]
  returnsProcessed   Return[]
  returnsApproved    Return[]          @relation("ReturnApprover")
  prescriptionsFilled Prescription[] @relation("Dispenser")
  prescriptionsVerified Prescription[] @relation("Verifier")
  logs               AuditLog[]
  productHistory     ProductHistory[]
  ownedCompany      Company?  @relation("CompanyOwner")
  stockTakes        StockTake[]  @relation("StockTakeCounter")
  systemRole        SystemRole? @relation(fields: [role], references: [name])
}

// ============ CUSTOMERS / PATIENTS ============

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth String?
  gender      String?
  address     String?
  insuranceProvider String?
  insurancePolicyNo  String?
  allergies   String?  // Comma-separated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescriptions Prescription[]
  transactions Transaction[]
}

// ============ PRODUCTS / MEDICATIONS ============

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  RECALLED
}

model Product {
  id                String          @id @default(cuid())
  ndc               String?         @unique // National Drug Code
  name              String
  genericName       String?
  manufacturer      String?
  manufacturerId    String?
  vendorId          String?
  category          String          @default("OTC")
  description       String?
  dosageForm        String?         // Tablet, Capsule, Liquid, Cream, etc.
  strength          String?         // 500mg, 10ml, etc.
  unitOfMeasure     String          @default("EA") // EA, BOX, PACK
  requiresPrescription Boolean      @default(false)
  status            ProductStatus   @default(ACTIVE)
  sellingPrice      Float
  costPrice         Float?
  reorderPoint      Int             @default(10)
  reorderQty        Int             @default(50)
  maxStock          Int?
  storageLocation   String?         // Aisle, Shelf, Bin
  batchNumber       String?
  expiryDate        String?
  controlledSubstance Boolean       @default(false)
  deaSchedule       String?         // For controlled substances
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  manufacturerRef   Manufacturer?   @relation("ProductManufacturer", fields: [manufacturerId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  inventory         Inventory[]
  transactionItems  TransactionItem[]
  categories        Category[]
  returns           Return[]
  stockTakeItems    StockTakeItem[]
  history           ProductHistory[]
}

// ============ INVENTORY ============

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int      @default(0)
  lastCounted DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId])
}

// ============ TRANSACTIONS / SALES ============

enum TransactionStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  INSURANCE
  FSA_HSA
  SPLIT
}

model Transaction {
  id              String            @id @default(cuid())
  transactionNo   String            @unique
  customerId      String?
  userId          String
  subtotal        Float
  tax             Float             @default(0)
  discount        Float             @default(0)
  total           Float
  paymentMethod   PaymentMethod
  paymentAmount   Float
  changeAmount    Float             @default(0)
  status          TransactionStatus @default(PENDING)
  prescriptionId  String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  prescription    Prescription?     @relation(fields: [prescriptionId], references: [id])
  items           TransactionItem[]
  returns         Return[]

  hardwareLog     HardwareLog?
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  unitPrice     Float
  subtotal      Float
  requiresRx    Boolean     @default(false)
  dispensedQty  Int?
  createdAt     DateTime    @default(now())

  transaction       Transaction @relation(fields: [transactionId], references: [id])
  product           Product     @relation(fields: [productId], references: [id])
  returns           Return[]
}

// ============ PRESCRIPTIONS ============

enum RxStatus {
  PENDING
  IN_PROGRESS
  READY
  DISPENSED
  EXPIRED
  CANCELLED
}

enum RxPriority {
  ROUTINE
  URGENT
  STAT
}

model Prescription {
  id                String      @id @default(cuid())
  rxNumber          String      @unique
  customerId        String
  patientName       String
  prescriberName    String
  prescriberNPI     String?
  prescriberPhone   String?
  prescriberFax     String?
  productName       String
  productNdc        String?
  dosage            String?
  quantity          Int
  refillsRemaining  Int
  refillsTotal      Int
  daysSupply        Int?
  dispenseAsWritten Boolean     @default(false)
  priority          RxPriority   @default(ROUTINE)
  status            RxStatus     @default(PENDING)
  notes             String?
  filledById        String?
  verifiedById      String?
  filledAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer   @relation(fields: [customerId], references: [id])
  filledBy          User?      @relation("Dispenser", fields: [filledById], references: [id])
  verifiedBy        User?      @relation("Verifier", fields: [verifiedById], references: [id])
  transactions      Transaction[]
}

// ============ HARDWARE LOG ============

enum HardwareAction {
  RECEIPT_PRINTED
  LABEL_PRINTED
  BARCODE_SCANNED
  CASH_DRAWER_OPENED
  SCALE_READ
}

model HardwareLog {
  id            String         @id @default(cuid())
  transactionId String?        @unique
  hardwareType  String         // receipt_printer, barcode_scanner, cash_drawer, label_printer, scale
  action        HardwareAction
  status        String         @default("success") // success, failed, pending
  details       String?        // JSON string with device details
  createdAt     DateTime       @default(now())

  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
}

// ============ GOODS RETURNS ============

enum ReturnStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  EXPIRED
  WRONG_ITEM
  WRONG_QUANTITY
  DAMAGED
  CUSTOMER_CHANGE_OF_MIND
  RECALLED
  OTHER
}

model Return {
  id              String        @id @default(cuid())
  returnNo        String        @unique // RTN-YYYYMMDD-XXXX
  transactionId   String
  transactionItemId String
  productId       String
  productName     String
  quantity        Int
  unitPrice       Float
  refundAmount    Float
  reason          ReturnReason
  reasonNote      String?
  customerId      String?
  customerName    String?
  userId          String         // who processed the return
  status          ReturnStatus  @default(PENDING_APPROVAL)
  approvedById    String?
  approvedAt      DateTime?
  refundMethod     PaymentMethod @default(CASH)
  refundProcessed Boolean       @default(false)
  restocked       Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transaction      Transaction      @relation(fields: [transactionId], references: [id])
  transactionItem  TransactionItem  @relation(fields: [transactionItemId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  approvedBy       User?            @relation("ReturnApprover", fields: [approvedById], references: [id])
}

// ============ COMPANY / STORE ============

model Company {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique // URL-friendly name
  logo              String?  // Logo URL or base64
  tagline           String?
  businessType      String   @default("Pharmacy") // Pharmacy, Clinic, Hospital, Retail
  registrationNo    String?  // Business registration number
  pharmacyLicense   String?  // Pharmacy license number
  taxId             String?
  phone             String?
  email             String?
  website           String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  currency          String   @default("USD")
  timezone          String   @default("UTC")
  active            Boolean  @default(true)
  ownerName         String?
  ownerId           String?  @unique // User ID of the company owner
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner             User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
}

// ============ MANUFACTURERS ============

model Manufacturer {
  id          String   @id @default(cuid())
  name        String   @unique
  contactPerson String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[] @relation("ProductManufacturer")
}

// ============ VENDORS ============

model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
}

// ============ CATEGORIES ============

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ============ AUDIT LOG ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model ProductHistory {
  id            String   @id @default(cuid())
  productId     String
  action        String   // CREATED, UPDATED, DELETED
  changedFields String?  // comma-separated list of changed field names
  previousValues String? // JSON string of previous field values
  newValues     String?  // JSON string of new field values
  userId        String?
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
}

// ============ STOCK TAKE ============

enum StockTakeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockTake {
  id          String          @id @default(cuid())
  reference   String          @unique
  status      StockTakeStatus @default(PENDING)
  notes       String?
  countedBy   String?         // userId
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  countedByUser User?          @relation("StockTakeCounter", fields: [countedBy], references: [id])
  items         StockTakeItem[]
}

model StockTakeItem {
  id            String   @id @default(cuid())
  stockTakeId   String
  productId     String
  systemQty     Int      // current quantity in inventory
  countedQty    Int?     // physical count
  variance      Int?     // countedQty - systemQty
  notes         String?
  createdAt     DateTime @default(now())

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([stockTakeId, productId])
}
