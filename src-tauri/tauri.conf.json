{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SelRx Pharmacy",
  "version": "0.2.1",
  "identifier": "com.selrx.pharmacy",
  "copyright": "Copyright \u00a9 2026 SelRx Pharmacy",
  "authors": ["SelRx"],
  "shortDescription": "SelRx Pharmacy Management System",
  "longDescription": "A comprehensive pharmacy POS and inventory management system for retail pharmacies. Manage sales, inventory, prescriptions, customers, and reports.",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../out"
  },
  "app": {
    "title": "SelRx Pharmacy",
    "windows": [
      {
        "title": "SelRx Pharmacy",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.turso.tech https://*.vercel.app http://localhost:* https://*.space-z.ai; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": ""
    }
  }
}