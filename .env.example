# ============================================================================
# SelRx POS — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ── Database (required) ──
DATABASE_URL=file:./local.db

# Turso Cloud DB (required for Vercel/web deployment)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Security (REQUIRED — app will not start without these) ──
# Used for NextAuth JWT signing. Must be at least 16 characters.
NEXTAUTH_SECRET=

# Used for our custom JWT tokens (login API). If not set, falls back to NEXTAUTH_SECRET.
JWT_SECRET=

# ── Encryption (required for AES-256 encryption features) ──
# Must be EXACTLY 32 characters (256 bits) for AES-256.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AES_ENCRYPTION_KEY=

# ── Sync (required for hub/terminal mode) ──
# Shared secret for hub-terminal sync authentication.
# Must match on all hub and terminal devices.
SYNC_SECRET=

# ── Setup Protection (recommended) ──
# If set, POST /api/company-setup requires this token in the request body.
# Prevents unauthorized initial account creation.
SETUP_TOKEN=

# ── CORS (for web deployment) ──
# Allowed origin(s) for API CORS headers (comma-separated).
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ── App ──
PORT=3000
NODE_OPTIONS=--max-old-space-size=256
